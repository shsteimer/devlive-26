{
  "name": "devlive-26",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Veloxa – Edge Delivery Services demo site",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "prepare": "husky",
    "dev:auth": "npx wrangler dev --config ./workers/auth/wrangler.toml",
    "deploy:auth": "npx wrangler deploy --config ./workers/auth/wrangler.toml",
    "dev:cdn": "npm install --prefix ./workers/cdn && npx wrangler dev --config ./workers/cdn/wrangler.toml",
    "deploy:cdn": "npm install --prefix ./workers/cdn && npx wrangler deploy --config ./workers/cdn/wrangler.toml",
    "test": "node --test \"test/**/*.test.js\" \"workers/cdn/test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"test/**/*.test.js\" \"workers/cdn/test/*.test.js\"",
    "pretest:e2e": "node test/support/check-e2e-content.js",
    "test:e2e": "playwright test --grep-invert \"@analytics|@regression\"",
    "test:e2e:regression": "playwright test --grep @regression",
    "test:e2e:analytics": "playwright test --grep @analytics"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.0.2",
    "eslint-plugin-import": "^1.14.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "stylelint": "17.3.0",
    "stylelint-config-standard": "40.0.0"
  }
}
